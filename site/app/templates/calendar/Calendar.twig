{% import _self as self %}

{# Begin Calendar - JSON data stored in data attributes to avoid render-blocking #}
<div id="calendar-data" 
     data-gradeables="{{ gradeables_by_date|json_encode|e('html_attr') }}"
     data-curr-year="{{ curr_year }}"
     data-curr-month="{{ curr_month }}"
     data-curr-day="{{ curr_day }}"
     data-instructor-courses="{{ instructor_courses|json_encode|e('html_attr') }}"
     data-global-items="{{ global_items_by_date|json_encode|e('html_attr') }}"
     data-is-superuser="{{ is_superuser ? 'true' : 'false' }}"
     data-show-legend="{{ show_legend }}"
     style="display:none;">
</div>

<script>
    // Initialize calendar after DOM is ready (non-blocking)
    document.addEventListener('DOMContentLoaded', function() {
        // Parse data from data attributes
        const calendarData = document.getElementById('calendar-data');
        window.gradeables_by_date = JSON.parse(calendarData.dataset.gradeables);
        window.curr_year = parseInt(calendarData.dataset.currYear);
        window.curr_month = parseInt(calendarData.dataset.currMonth);
        window.curr_day = parseInt(calendarData.dataset.currDay);
        window.instructor_courses = JSON.parse(calendarData.dataset.instructorCourses);
        window.global_items_by_date = JSON.parse(calendarData.dataset.globalItems);
        window.is_superuser = calendarData.dataset.isSuperuser === 'true';
        
        // Wait for jQuery to be available
        const initCalendar = function() {
            const type = $("#calendar-item-type-edit").val();
            let cookie_year = parseInt(Cookies.get('calendar_year'));
            let cookie_month = parseInt(Cookies.get('calendar_month'));
            let cookie_day = parseInt(Cookies.get('calendar_day'));
            
            if (isNaN(cookie_year)) cookie_year = curr_year;
            if (isNaN(cookie_month)) cookie_month = curr_month;
            if (isNaN(cookie_day)) cookie_day = curr_day;
            
            loadCalendar(cookie_month, cookie_year, cookie_day, type);
            
            if (parseInt(calendarData.dataset.showLegend) === 1) {
                colorLegend();
            }
        };
        
        if (typeof $ !== 'undefined') {
            $(document).ready(initCalendar);
        } else {
            // jQuery not loaded yet, wait for it
            window.addEventListener('load', initCalendar);
        }
    });
</script>
<div class="content">
    <h1>Calendar</h1>
    <div class="cal-content">
        <div class="cal-toolbar">
            {% if instructor_courses|length > 0 %}
                <button type="button" onclick="openNewItemModal()" class="btn btn-primary">
                    <i class="fas fa-plus"></i> New Item
                </button>
            {% endif %}
            {% if is_superuser %}
                <button type="button" onclick="openNewGlobalEventModal()" class="btn btn-primary">
                    <i class="fas fa-plus"></i> New Global Event
                </button>
            {% endif %}
                <button type="button" onclick="openOptionsModal()" class="btn btn-primary">
                    <i class="fas fa-sliders"></i> Options
                </button>
                <select id="calendar-item-type-edit" name="type" onchange="changeView(this, {{view_year}}, {{view_month}});">
                    <option value="month" {% if (view_cookie is defined) and view_cookie == "month" %} selected {% endif %}>Month</option>
                    <option value="two_week" {% if (view_cookie is defined)  and view_cookie == "two_week" %} selected {% endif %}>Two Week</option>
                    <option value="one_week" {% if (view_cookie is defined)  and view_cookie == "one_week" %} selected {% endif %}>One Week</option>
                </select>
                <button id="calendar-today-button" type="button" onclick="setDateToToday()" class="btn btn-primary">
                    <i class="fas fa-clock"></i> Today
                </button>
        </div>

        {# Legend #}
        {% if show_legend == 1 %}
        <div class="cal-legend">
            {% if show_all_cookie == 1 %}
                {% for course in course_names %}
                <div 
                    name="{{ course.course_name|replace({' ':''}) }}" 
                    class="legend-color" 
                    onclick="filter_course('{{ course.course_name }}', '{{ course.display_name }}')" 
                    style="cursor: pointer;" 
                    title="Click to filter course, click again to show all courses"
                    aria-label="Filter course {{ course.display_name }}"
                ></div>
                <p 
                    for="{{ course.course_name|replace({' ':''}) }}-color" 
                    style="cursor: pointer;" 
                    onclick="filter_course('{{ course.course_name }}', '{{ course.display_name }}')" 
                    title="Click to filter course, click again to show all courses" 
                    class="legend-label"
                >{{ course.display_name }}</p>
                {% endfor %}
                {% else %}
                <div 
                    name="{{ calendar_course_cookie|replace({' ':''}) }}" 
                    class="legend-color" 
                    onclick="filter_course('show all', '')"
                    style="cursor: pointer;" 
                    title="Click to open Calendar options form"
                    aria-label="Show all courses"
                ></div>
                <p 
                    for="{{ calendar_course_cookie|replace({' ':''}) }}-color" 
                    style="cursor: pointer;" 
                    onclick="filter_course('show all', '')" 
                    title="Click to filter course, click again to show all courses" 
                    class="legend-label"
                    >{{display_name_cookie}}
                </p>
            {% endif %}
        </div>
        {% endif %}

        <div class="calendar" style='margin-bottom: 20px;' id="full-calendar">
            {# Replace by js function call #}
        </div>
    </div>

    {% if show_table == 1 %}
    {# List items in table #}
        <div class="lst-content">
            {% if gradeables_by_section|length > 0 %}
                <div id="gradeables">
                {% for section_num, info in gradeables_by_section %}
                    <div style="margin-bottom: 20px">
                        <div id="{{ info.section_id }}" class="course-section-heading">
                            <div class="course-section-title">
                                {{ info.title }}
                                {% if info.subtitle != "" %}
                                    &nbsp;&nbsp;<em>{{ info.subtitle }}</em>
                                {% endif %}
                            </div>
                        </div>

                        <table class="table table-striped table-bordered persist-area mobile-table" style="text-align: left" id="calendar-list">
                            <thead>
                                <tr>
                                    <th>Course</th>
                                    <th>Gradeable</th>
                                    <th>Submission Closes</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for id, gradeable in info.gradeables %}
                                <tr>
                                    <td>{{ gradeable.course }}</td>
                                    <td><a href="{{ gradeable.url }}">{{ gradeable.title }}</a></td>
                                    <td>{{ gradeable.submission }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endfor %}
                </div>
            {% else %}
                <div class="container">
                    <p>{{ empty_message }}</p>
                </div>
            {% endif %}
        </div>
    {% endif %}
</div>



